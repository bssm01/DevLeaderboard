# --- Server ---
PORT=3000

# --- MongoDB ---
# Option A: full connection string (wins over everything below when set).
# Atlas:    mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/wawachi?retryWrites=true&w=majority
# Local:    mongodb://localhost:27017/wawachi
DATABASE_URL=
# Option B: discrete fields (used when DATABASE_URL is empty).
# For Atlas set SCHEME=mongodb+srv and HOST=cluster0.xxxxx.mongodb.net
# (PORT is ignored with srv — SRV records publish their own port).
DATABASE_HOST=localhost
DATABASE_PORT=27017
DATABASE_SCHEME=mongodb
# Must be set together, or both left empty for a local unauthenticated MongoDB.
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=devleaderboard

# --- Auth (JWT_SECRET is required, minimum 16 characters; use 32+ random chars in production) ---
JWT_SECRET=
JWT_EXPIRES_MINUTES=60

# --- Rate limiting ---
# Global bucket (applied to /auth):
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Tighter bucket for POST /leaderboard/:org/refresh (it spends GitHub quota):
RATE_LIMIT_REFRESH_WINDOW_MS=900000
RATE_LIMIT_REFRESH_MAX=10

# --- GitHub (REQUIRED to boot) ---
# Classic PAT scopes: repo + read:org
GITHUB_TOKEN=
# Optional overrides:
# GITHUB_API_URL=https://api.github.com
# GITHUB_TIMEOUT_MS=15000

# --- Leaderboard score weights ---
SCORE_COMMIT=5
SCORE_PR=10
SCORE_REVIEW=3
SCORE_ISSUE=2

# --- Scheduled refresh (standard 5-field cron, server timezone) ---
LEADERBOARD_CRON=0 */6 * * *
# Comma-separated org logins to refresh automatically. Empty = scheduler off
# (POST /leaderboard/:org/refresh still works for any org).
LEADERBOARD_ORGS=

# --- Logging ---
# debug | info | warn | error  (one JSON object per line)
LOG_LEVEL=info
