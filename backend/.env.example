# --- Server ---
PORT=3000

# --- MongoDB ---
# Option A: full connection string (wins over everything below when set).
# Atlas:    mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/wawachi?retryWrites=true&w=majority
# Local:    mongodb://localhost:27017/wawachi
DATABASE_URL=
# Option B: discrete fields (used when DATABASE_URL is empty).
# For Atlas set SCHEME=mongodb+srv and HOST=cluster0.xxxxx.mongodb.net
# (PORT is ignored with srv — SRV records publish their own port).
DATABASE_HOST=localhost
DATABASE_PORT=27017
DATABASE_SCHEME=mongodb
# Must be set together, or both left empty for a local unauthenticated MongoDB.
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=devleaderboard

# --- Rate limiting ---
# Bucket for POST /leaderboard/:org/refresh (it spends GitHub quota):
RATE_LIMIT_REFRESH_WINDOW_MS=900000
RATE_LIMIT_REFRESH_MAX=10

# --- GitHub (REQUIRED to boot) ---
# Classic PAT scopes: repo + read:org (full member list, private repos).
# A fine-grained PAT also works: public members + public repo contributors are
# used automatically when the token cannot read org membership.
GITHUB_TOKEN=
# Optional overrides:
# GITHUB_API_URL=https://api.github.com
# GITHUB_TIMEOUT_MS=15000

# --- Leaderboard score weights ---
SCORE_COMMIT=5
SCORE_PR=10
SCORE_REVIEW=3
SCORE_ISSUE=2

# --- Scheduled refresh (standard 5-field cron, server timezone) ---
LEADERBOARD_CRON=0 */6 * * *
# Comma-separated org logins to refresh automatically. Defaults to the site's
# org; set to an empty value to disable the scheduler.
LEADERBOARD_ORGS=MicroClub-USTHB
# Optional external projects counted on top of the org's own repositories.
# Format: org=owner/repo, comma-separated. Empty by default: the board counts
# organization repositories only. Example:
# LEADERBOARD_EXTRA_REPOS=MicroClub-USTHB=owner/project
LEADERBOARD_EXTRA_REPOS=

# --- Logging ---
# debug | info | warn | error  (one JSON object per line)
LOG_LEVEL=info

# --- Dev department filter (optional) ---
# The leaderboard has two filters: Global (everyone who contributed) and Dev
# (the Dev department only). MCID says who is in the Dev department: members
# holding one of these Discord roles, with the GitHub account they linked.
# Leave MCID_URL empty to turn the Dev filter off; Global keeps working.
# MCID API root, ending in /api:
MCID_URL=
# The API key of an MCID project registered for this site:
MCID_API_KEY=
# Comma-separated Discord role ids that make up the Dev department:
MCID_DEV_ROLE_IDS=
# How long the Dev list is reused before MCID is asked again (milliseconds):
# MCID_ROSTER_TTL_MS=600000
